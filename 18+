// File: pages/api/stripe/webhook.ts (Stripe Webhook)
import type { NextApiRequest, NextApiResponse } from 'next';
import Stripe from 'stripe';
import { assignRoleToUser } from '@/lib/discord';

export const config = {
  api: {
    bodyParser: false,
  },
};

const stripeInstance = new Stripe(process.env.STRIPE_SECRET_KEY!, { apiVersion: '2023-08-16' });

const buffer = async (readable: any) => {
  const chunks = [];
  for await (const chunk of readable) chunks.push(typeof chunk === 'string' ? Buffer.from(chunk) : chunk);
  return Buffer.concat(chunks);
};

export default async function handler(req: NextApiRequest, res: NextApiResponse) {
  const sig = req.headers['stripe-signature']!;
  const buf = await buffer(req);
  let event;

  try {
    event = stripeInstance.webhooks.constructEvent(buf, sig, process.env.STRIPE_WEBHOOK_SECRET!);
  } catch (err: any) {
    return res.status(400).send(`Webhook Error: ${err.message}`);
  }

  if (event.type === 'checkout.session.completed') {
    const session = event.data.object as Stripe.Checkout.Session;
    const discordId = session.metadata?.discordId;
    const roleId = session.metadata?.roleId;
    if (discordId && roleId) {
      await assignRoleToUser(discordId, roleId);
    }
  }

  res.status(200).json({ received: true });
}

// File: lib/discord.ts
import fetch from 'node-fetch';

export async function assignRoleToUser(discordId: string, roleId: string) {
  const botToken = process.env.DISCORD_BOT_TOKEN;
  const guildId = process.env.DISCORD_GUILD_ID;

  await fetch(`https://discord.com/api/v10/guilds/${guildId}/members/${discordId}/roles/${roleId}`, {
    method: 'PUT',
    headers: {
      Authorization: `Bot ${botToken}`,
      'Content-Type': 'application/json',
    },
  });
}

// File: pages/api/subscribe.ts (Stripe Checkout Session Creator)
import { getServerSession } from 'next-auth';
import { authOptions } from '@/lib/authOptions';
import Stripe from 'stripe';

const stripeInstance = new Stripe(process.env.STRIPE_SECRET_KEY!, { apiVersion: '2023-08-16' });

export default async function handler(req, res) {
  const session = await getServerSession(req, res, authOptions);
  if (!session) return res.status(401).json({ error: 'Unauthorized' });

  const discordId = session.user.id;
  const { priceId, roleId } = req.body;

  const checkoutSession = await stripeInstance.checkout.sessions.create({
    mode: 'subscription',
    payment_method_types: ['card'],
    line_items: [{ price: priceId, quantity: 1 }],
    metadata: { discordId, roleId },
    success_url: `${process.env.NEXT_PUBLIC_BASE_URL}/success`,
    cancel_url: `${process.env.NEXT_PUBLIC_BASE_URL}/cancel`,
  });

  res.json({ url: checkoutSession.url });
}

